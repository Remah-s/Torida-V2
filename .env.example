FLASK_ENV=production
PORT=5000
SECRET_KEY=replace-me
JWT_SECRET_KEY=replace-me

# Set one of the database options below.
# Railway MySQL service variables usually expose MYSQL_URL automatically.
MYSQL_URL=mysql://user:password@host:3306/torida

# Optional explicit database variables if you are not using MYSQL_URL
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=torida

# Public frontend/backend configuration
PUBLIC_API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

# Persist uploads with a Railway volume in production, e.g. /data/uploads
UPLOAD_FOLDER=uploads

# Optional email settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Torida <noreply@torida.com>

