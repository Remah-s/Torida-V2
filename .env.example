# ============================================
# TORIDA Backend Environment Variables
# ============================================
# Copy this file to .env for local development
# For Vercel: Import these variables to Vercel Dashboard
#
# HOW TO IMPORT TO VERCEL:
# 1. Fill in all required values below
# 2. Go to https://vercel.com/dashboard
# 3. Select your project → Settings → Environment Variables
# 4. Add each variable and select all environments
# 5. Redeploy your project
# ============================================

# ============================================
# CRITICAL: Required for Production
# ============================================

# Flask Configuration
FLASK_ENV=production
PORT=5000
SECRET_KEY=your-super-secret-key-change-this-in-production
PUBLIC_API_BASE_URL=https://your-vercel-app.vercel.app

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ============================================
# Database Configuration (Choose ONE option)
# ============================================

# OPTION 1: Connection String (Recommended for Railway/Vercel)
# Uncomment and use this if you have a MYSQL_URL from your provider
# MYSQL_URL=mysql://user:password@host:3306/torida

# OPTION 2: Individual Database Variables (Recommended for manual setup)
# Uncomment and fill in these if you don't have MYSQL_URL
MYSQLHOST=your-mysql-host.com
MYSQLPORT=3306
MYSQLUSER=your_database_user
MYSQLPASSWORD=your_database_password
MYSQLDATABASE=torida

# ============================================
# CORS Configuration
# ============================================
# For local development (allow all)
CORS_ORIGINS=*

# For production, specify exact origins (comma-separated):
# CORS_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# ============================================
# File Upload Configuration
# ============================================
# Local development: uploads folder
# Vercel/Production: /tmp/uploads (temporary) - consider using cloud storage
UPLOAD_FOLDER=/tmp/uploads

# Maximum file size in bytes (16MB default)
MAX_CONTENT_LENGTH=16777216

# Allowed file extensions
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp

# ============================================
# Email Configuration (Optional)
# ============================================
# Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=Torida <noreply@torida.com>

# ============================================
# OTP Configuration
# ============================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# ============================================
# Pagination Configuration
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# VERCEL DEPLOYMENT CHECKLIST
# ============================================
# Required variables to set on Vercel:
# 
# ✅ FLASK_ENV=production
# ✅ SECRET_KEY=<strong-random-key>
# ✅ JWT_SECRET_KEY=<strong-random-key>
# ✅ MYSQLHOST=<your-db-host> (or use MYSQL_URL)
# ✅ MYSQLPORT=3306
# ✅ MYSQLUSER=<your-db-user>
# ✅ MYSQLPASSWORD=<your-db-password>
# ✅ MYSQLDATABASE=torida
# ✅ CORS_ORIGINS=*
# 
# Optional but recommended:
# ✅ PUBLIC_API_BASE_URL=https://your-app.vercel.app
# ✅ MAIL_* variables if using email
#
# ============================================


